# ---------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Every VITE_* value is embedded into the client bundle at build time
# and is therefore PUBLIC. Never put a real secret, API key, or
# database credential in here.
# ---------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs,
# Open Graph image URLs, and structured data.
VITE_SITE_URL=https://tanvo.in

# --- Contact details -------------------------------------------
# Anything left blank is simply not rendered, rather than showing a
# placeholder. Fill these in before launch.
VITE_CONTACT_EMAIL=hello@tanvo.in
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=

# --- Social links ----------------------------------------------
# Full URLs. Blank entries are hidden instead of linking to a bare
# github.com / linkedin.com homepage.
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=

# --- Contact form delivery -------------------------------------
# A URL that accepts a JSON POST of { name, email, service, message }.
# Works with Formspree, Web3Forms, Basin, or your own endpoint.
# If left blank the form falls back to opening the visitor's mail
# client — messages are never silently discarded either way.
VITE_CONTACT_ENDPOINT=

# --- Admin gate -------------------------------------------------
# Generate both values with:  npm run admin:hash
# Read src/lib/auth.js first: this is obfuscation, not authentication.
VITE_ADMIN_SALT=
VITE_ADMIN_PASSWORD_HASH=

